---
interface Props {
	label: string;
}

const { label } = Astro.props;
---

<section>
	<h2>{label}</h2>
	<slot />
</section>

<style>
	h2 {
		margin-block-end: 2rem;

		font-family: var(--font-sans);
		font-size: var(--text-smallest);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-secondary);
	}
</style>
